# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Workspace service account (domain-wide delegation), impersonating
# the single admin account per TSS_App_Spec_1.md section 1.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_ADMIN_EMAIL=info@tarasimonstudios.com

# Shared Drive folder the studio manages by hand for the Exercises
# Library catalog (add/remove audio files there, then sync from
# /admin/exercises) — GOOGLE_ADMIN_EMAIL above must have access to it.
GOOGLE_EXERCISES_FOLDER_ID=

# Kajabi Pro-tier API (OAuth2 client_credentials — Public API settings page
# of the Kajabi Dashboard). KAJABI_WEBHOOK_SECRET is NOT an HMAC key —
# Kajabi doesn't sign webhooks — it's a token WE chose, appended as
# ?secret=... on the webhook URL configured in Kajabi. Per
# TSS_App_Spec_1.md section 1.
KAJABI_CLIENT_ID=
KAJABI_CLIENT_SECRET=
KAJABI_WEBHOOK_SECRET=

# Shared secret Vercel Cron sends back on each invocation, so
# /api/cron/kajabi-sync only runs for real scheduled calls.
CRON_SECRET=

# Transactional email (magic-link delivery — Resend, since Kajabi Pages
# can't merge a per-member token into a link; see section 1).
RESEND_API_KEY=
EMAIL_FROM="Tara Simon Studios <login@portal.tarasimonstudios.com>"

# This app's own public URL, used to build the magic-link login link.
# http://localhost:3000 while developing locally.
NEXT_PUBLIC_APP_URL=

# Slack Incoming Webhook — posts a message whenever a coach or admin adds
# a time-off block, so admin knows without checking the dashboard. Also
# the shared staff ops channel for the automated notifications (recording
# needs manual review, weekly ops summary — lib/notifications/create.ts's
# notifyStaff). A coach's own personal Slack channel is separate — set per
# coach in the admin Coaches UI (coaches.slack_webhook_url), not an env var.
SLACK_WEBHOOK_URL=

# Outbound webhook to GoHighLevel. This app fires {event, studentId, email,
# phone, channels, data}; GHL's own workflow builder (studio-configured,
# not part of this codebase) owns template/send/timing for student
# email+SMS notifications (weekly digest, session reminders, recording
# ready, makeup-credit nudges). Best-effort — swallowed on failure, never
# blocks a cron run, same posture as SLACK_WEBHOOK_URL.
GHL_WEBHOOK_URL=

# Studio's Kajabi site root — the student dashboard's Courses/Community
# nav links point at {this}/courses and {this}/community (Kajabi owns
# that content, section 1). Placeholder until the exact per-section URLs
# are confirmed.
NEXT_PUBLIC_KAJABI_SITE_URL=

# Stripe — self-serve billing, lives at NEXT_PUBLIC_APP_URL/billing/... (a
# normal path in this same app, not a separate domain — a billing.*
# subdomain was tried and dropped in favor of this, since a same-origin
# path shares the student's existing session automatically with none of
# the domain/DNS/cookie-scoping overhead a separate subdomain needed).
# Secret/webhook secret from the Stripe Dashboard (test mode while building,
# live mode only on cutover — see PROGRESS.md). This is the studio's
# CURRENT account — all new signups go here (see app/api/billing/checkout).
# Publishable key is safe to expose to the browser (Payment Element, for
# card updates — app/billing/account/payment-method-client.tsx).
#
# Price IDs: the CURRENT, PUBLIC price per tier/interval only — never a
# grandfathered/legacy one (Stripe can hold as many extra Prices per
# Product as needed for old cohorts/promos; only the ones listed here
# are ever offered to a new signup — see lib/stripe/tiers.ts's own
# comment). Every _MONTHLY/_3MONTH/_6MONTH/_YEARLY is optional per tier —
# leave unset if that tier/interval combo isn't offered (the pricing page
# just won't show a toggle for it). _3MONTH/_6MONTH exist for
# time-limited promo pricing — no expiry logic in code, removing the env
# var (then redeploying) is how a promo actually ends.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_LITE_MONTHLY=
STRIPE_PRICE_LITE_3MONTH=
STRIPE_PRICE_LITE_6MONTH=
STRIPE_PRICE_LITE_YEARLY=
STRIPE_PRICE_SUITE_MONTHLY=
STRIPE_PRICE_SUITE_3MONTH=
STRIPE_PRICE_SUITE_6MONTH=
STRIPE_PRICE_SUITE_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_3MONTH=
STRIPE_PRICE_PRO_6MONTH=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ELITE_MONTHLY=
STRIPE_PRICE_ELITE_3MONTH=
STRIPE_PRICE_ELITE_6MONTH=
STRIPE_PRICE_ELITE_YEARLY=

# The studio's LEGACY Stripe account ("Opus") — pre-migration customers
# only, never new signups (supabase/migrations/0102_stripe_dual_account.sql).
# Both accounts' webhooks point at the same /api/webhooks/stripe URL;
# that route tries verifying against STRIPE_WEBHOOK_SECRET above first,
# then this one.
OPUS_STRIPE_SECRET_KEY=
OPUS_STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_OPUS_STRIPE_PUBLISHABLE_KEY=
